<Window x:Class="Printing_Judge_Notifications.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Printing_Judge_Notifications"
        mc:Ignorable="d"
        Title="Печать уведомлений"
        Width="900" Height="615"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- Две колонки, чтобы кнопка и прогресс-бар могли быть в правой или левой части при желании -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Верхняя строка: кнопка -->
            <RowDefinition Height="*"/>
            <!-- Средняя строка: DataGrid на всё оставшееся место -->
            <RowDefinition Height="5"/>
            <!-- Нижняя строка: ровно 5 мм под прогресс-бар -->
        </Grid.RowDefinitions>

        <!-- Кнопка загрузки файла -->


        <DataGrid x:Name="dataGrid"
          Grid.Row="1"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          AutoGenerateColumns="False"
          CanUserResizeColumns="True"
          CanUserResizeRows="True"
          CanUserAddRows="False"
          IsReadOnly="True"
          ScrollViewer.HorizontalScrollBarVisibility="Visible"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#CCCCCC"
          VerticalGridLinesBrush="#CCCCCC"
          RowBackground="#FFFFFF"
          AlternatingRowBackground="#F9F9F9"
          BorderThickness="0"
          Margin="0"
          
            VirtualizingStackPanel.IsVirtualizing="True"
          VirtualizingStackPanel.VirtualizationMode="Recycling"
          VirtualizingPanel.ScrollUnit="Pixel"
          >

            <!-- Стиль заголовка: жирный, центрированный, без лишних рамок -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Background" Value="#EFEFEF"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Стиль ячейки: рамка, аккуратные отступы -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0,1,1,0"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <!-- 1. Судебный пристав -->
                <DataGridTextColumn Binding="{Binding CourtOfficer}" Width="Auto" MinWidth="200">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Судебный пристав и иная информация" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 2. Дата проверки -->
                <DataGridTextColumn Binding="{Binding DateOfVerification, StringFormat={}{0:dd.MM.yyyy}}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата проверки" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 3. № судебного участка -->
                <DataGridTextColumn Binding="{Binding NumberOfJudicalArea}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№ судебного участка" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 4. Лицевой счёт -->
                <DataGridTextColumn Binding="{Binding Account}" Width="120">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Лицевой счёт" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- 5. ФИО должника -->
                <DataGridTextColumn Binding="{Binding FullName}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ФИО должника" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 6. Доля в праве -->
                <DataGridTextColumn Binding="{Binding Part}" Width="90">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Доля в праве" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 7. Населённый пункт -->
                <DataGridTextColumn Binding="{Binding Town}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Населённый пункт" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 8. Улица -->
                <DataGridTextColumn Binding="{Binding Street}" Width="140">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Улица" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 9. Дом -->
                <DataGridTextColumn Binding="{Binding Building}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дом" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 10. Корпус -->
                <DataGridTextColumn Binding="{Binding Korps}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Корпус" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 11. Квартира -->
                <DataGridTextColumn Binding="{Binding Flat}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Квартира" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 12. Комната -->
                <DataGridTextColumn Binding="{Binding Room}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Комната" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 13. Дата передачи MC -->
                <DataGridTextColumn Binding="{Binding RequestMCDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата передачи MC" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 14. № СП -->
                <DataGridTextColumn Binding="{Binding OrderNumber}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№ СП" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- 14. № СП -->
                <DataGridTextColumn Binding="{Binding OrderDate}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№ СП" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 15. Дата передачи ФССП -->
                <DataGridTextColumn Binding="{Binding TransferDateFSSP, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата передачи ФССП" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 16. Дата возбуждения ИП -->
                <DataGridTextColumn Binding="{Binding InitiationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата возбуждения ИП" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 17. Примечание -->
                <DataGridTextColumn Binding="{Binding Appendex}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Примечание" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 18. Дата рождения -->
                <DataGridTextColumn Binding="{Binding BirthDate}" Width="Auto" MinWidth="160">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата рождения должника" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 19. Период -->
                <DataGridTextColumn Binding="{Binding Period}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Период" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Суммы: выравнивание по правому краю -->
                <DataGridTextColumn Binding="{Binding Debt, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Основной долг" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Punishment, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Сумма пени" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Duty, StringFormat=N2}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Госпошлина" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding AmountSum, StringFormat=N2}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Сумма по исполнительному документу" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Документ -->
                <DataGridTextColumn Binding="{Binding DocumentReference}" Width="Auto" MinWidth="160">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Документ" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Прогресс-бар: строго в нижней строке высотой 5 мм, растягивается по ширине колонки -->
        <ProgressBar x:Name="progressBar1"
                     Visibility="Collapsed"
                     Margin="0,1,0,-6"
                     Height="10"
                     Grid.Row="2"
                     
                     Grid.Column="0"/>
        <UniformGrid Rows="1" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
            <Button x:Name="UploadFileButton"
            Content="Загрузить файл"
            Click="UploadFileButton_Click"
            Padding="8">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="MinWidth" Value="180"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="InitiationIP_PrintOut"
            Click="InitiationIP_PrintOut_Click"
            Padding="8">
                <TextBlock Text="Заявление о возбуждении ИП распечатать"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="MinWidth" Value="180"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="InitiationIP_PDF"
            Click ="InitiationIP_PDF_Click"
            Padding="8">
                <TextBlock Text="Заявление о ВОЗБУЖДЕНИИ ИП PDF"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="MinWidth" Value="180"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="CancelIP_PDF"
            Click="CancelIP_PDF_Click"
            Padding="8">
                <TextBlock Text="Заявление о ПРЕКРАЩЕНИИ ИП PDF"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="MinWidth" Value="180"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </Button.Style>
            </Button>
        </UniformGrid>

       
    </Grid>
</Window>
