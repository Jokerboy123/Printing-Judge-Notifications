<Window x:Class="Printing_Judge_Notifications.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Printing_Judge_Notifications"
        mc:Ignorable="d"
        Title="Печать уведомлений"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
<!-- Проверка привязки веток -->
    <!-- еще одна Проверка привязки веток -->
<!--fff-->
    <!-- СТИЛИ -->
    <Window.Resources>
        <!-- Стиль главной (зеленой) кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#138808"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вторичных (белых) кнопок -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#138808"/>
                                <Setter Property="BorderBrush" Value="#138808"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="radioButtonStyle" TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0, 4, 4, 0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>

            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#138808"/>

            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="16"/>
            <!-- Чуть уменьшил, чтобы было аккуратнее, можно вернуть 20 -->
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Рамка вокруг всей карточки -->
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6" 
                        Padding="{TemplateBinding Padding}">

                            <BulletDecorator Background="Transparent">
                                <!-- Кружок (Bullet) -->
                                <BulletDecorator.Bullet>
                                    <Grid Width="20" Height="20">
                                        <Ellipse x:Name="OuterCircle" 
                                         Stroke="#D1D5DB" 
                                         StrokeThickness="2"
                                         Width="16"
                                         Height="16"

                                        Fill="White"/>
                                        <Ellipse x:Name="InnerCircle" 
                                                 Width="15"
                                                 Height="15"
                                         Fill="#138808" 
                                         Visibility="Collapsed" 
                                        
                                                 />
                                    </Grid>
                                </BulletDecorator.Bullet>

                                <!-- Текст -->
                                <ContentPresenter HorizontalAlignment="Left" 
                                          VerticalAlignment="Center" 
                                          Margin="8,0,0,0"/>
                            </BulletDecorator>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#138808"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#138808"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#9CA3AF"/>
                            </Trigger>

                            <!-- Выбор (IsChecked) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="#E0E7FF"/>
                                <Setter Property="BorderBrush" Value="#138808"/>
                                <Setter Property="Foreground" Value="#138808"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="newradioButtonStyle" TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0, 4, 4, 0"/>
            <Setter Property="Height" Value="40"/>

            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#138808"/>

            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="16"/>
            <!-- Чуть уменьшил, чтобы было аккуратнее, можно вернуть 20 -->
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Рамка вокруг всей карточки -->
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6" 
                        Padding="{TemplateBinding Padding}">

                            <BulletDecorator Background="Transparent">
                                <!-- Кружок (Bullet) -->
                                <BulletDecorator.Bullet>
                                    <Grid Width="20" Height="20">
                                        <Ellipse x:Name="OuterCircle" 
                                         Stroke="#D1D5DB" 
                                         StrokeThickness="2"
                                         Width="16"
                                         Height="16"

                                        Fill="White"/>
                                        <Ellipse x:Name="InnerCircle" 
                                                 Width="15"
                                                 Height="15"
                                         Fill="#138808" 
                                         Visibility="Collapsed" 
                                        
                                                 />
                                    </Grid>
                                </BulletDecorator.Bullet>

                                <!-- Текст -->
                                <ContentPresenter HorizontalAlignment="Left" 
                                          VerticalAlignment="Center" 
                                          Margin="8,0,0,0"/>
                            </BulletDecorator>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#138808"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#138808"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#9CA3AF"/>
                            </Trigger>

                            <!-- Выбор (IsChecked) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="#E0E7FF"/>
                                <Setter Property="BorderBrush" Value="#138808"/>
                                <Setter Property="Foreground" Value="#138808"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ОСНОВНОЙ КОНТЕЙНЕР -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>


            <!-- Панель действий -->
            <RowDefinition Height="*"/>

            <!-- DataGrid -->
            <RowDefinition Height="5"/>

            <!-- Прогресс-бар -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ИСПРАВЛЕННАЯ ПАНЕЛЬ ДЕЙСТВИЙ (4 РАВНЫЕ КОЛОНКИ) -->
        <!-- ========================================== -->
        <Border  Grid.Row="0" Margin="0,0,0,15" Background="White">
            <Grid>

                <!-- 
                   ВАЖНО: 4 колонки одинаковой ширины (*) + 3 разделителя (10)
                   Колонка 0: Кнопка "Загрузить"
                   Колонка 1: Отступ
                   Колонка 2: Блок "Возбуждение (Печать)"
                   Колонка 3: Отступ
                   Колонка 4: Блок "Возбуждение (PDF)"
                   Колонка 5: Отступ
                   Колонка 6: Блок "Прекращение (PDF)"
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 0: Кнопка загрузки -->
                    <ColumnDefinition Width="10"/>
                    <!-- 1: Отступ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 2: Блок 1 -->
                    <ColumnDefinition Width="10"/>
                    <!-- 3: Отступ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 4: Блок 2 -->
                    <ColumnDefinition Width="10"/>
                    <!-- 5: Отступ -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- 5: Отступ -->
                    <ColumnDefinition Width="*"/>

                    <!-- 6: Блок 3 -->
                </Grid.ColumnDefinitions>

                <!-- ГЛАВНАЯ КНОПКА (Колонка 0) -->
                <Button x:Name="UploadFileButton"
                        Content="Загрузить файл"
                        Click="UploadFileButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MinHeight="50"/>

                <!-- БЛОК 1: Возбуждение ИП (Печать) (Колонка 2) -->
                <!-- БЛОК 1: Возбуждение ИП (Печать + PDF) -->
                <Border Grid.Column="1" 
        Background="WhiteSmoke" 
        BorderBrush="#E5E7EB" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="15" Grid.ColumnSpan="2" Margin="10,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Заголовок -->
                            <RowDefinition Height="*"/>
                            <!-- Кнопки -->
                        </Grid.RowDefinitions>

                        <TextBlock Text="Заявление о возбуждении ИП" 
                   FontWeight="Bold" 
                   FontSize="13" 
                   Foreground="#4B5563" 
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,12"
                   Grid.Row="0"/>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <!-- Небольшой отступ между кнопками -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Печать"
                                                                        x:Name ="print_v_btn"

                    Click="InitiationIP_PrintOut_Click"
                                    BorderBrush="#138808"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Row="0"/>

                            <Button Content="Создать word"
                    Click="InitiationIP_PDF_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                                                                        BorderBrush="#138808"

                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- БЛОК 2: Возбуждение ИП (PDF) - если нужен отдельный блок, но судя по скриншоту, это часть первого блока. 
    -->
                <Border Grid.Column="3" 
                    Background="WhiteSmoke"
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15" Grid.ColumnSpan="2" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопки -->
                            <!-- Заголовок -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Заявление о прекращении ИП" 
                            FontWeight="Bold" 
                            FontSize="13" 
                            Foreground="#4B5563" 
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Margin="0,0,0,12"
                            Grid.Row="0"/>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <!-- Небольшой отступ между кнопками -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Печать"
                                    x:Name ="print_p_btn"
Click="CancelIP_PrintOut_Click"
                                                                        BorderBrush="#138808"

Style="{StaticResource SecondaryButtonStyle}"
HorizontalAlignment="Stretch"
VerticalAlignment="Stretch"
                                    
Grid.Row="0"/>

                            <Button Content="Создать word"
                    Click="CancelIP_PDF_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                                                                        BorderBrush="#138808"

                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Блок "Выбор отделения" -->
                <Border Grid.Column="5" 
                    Background="WhiteSmoke"
        BorderBrush="#E5E7EB" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="5" 
        Margin="0,0,1,0" 
        Grid.ColumnSpan="2">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <TextBlock Text="Выбор района" 
    FontWeight="Bold" 
    FontSize="13" 
    Foreground="#4B5563" 
    TextWrapping="Wrap"
    TextAlignment="Center"
    Margin="0,10,0,9"
    Grid.Row="0"/>
                        <!-- WrapPanel сам расставит карточки в ряд и перенесет на новую строку -->
                        <WrapPanel Grid.Row="1" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center" 
                   ItemWidth="Auto">

                            <RadioButton GroupName="townChecked" x:Name="KURSK" Tag="1" Content="Курское" Style="{StaticResource radioButtonStyle}"/>
                            <RadioButton GroupName="townChecked" x:Name="GEO" Tag="4" Content="Георгиевск" Style="{StaticResource radioButtonStyle}"/>
                            <RadioButton GroupName="townChecked" x:Name="SOVET" Tag="3" Content="Советское" Style="{StaticResource radioButtonStyle}"/>
                            <RadioButton GroupName="townChecked" x:Name="STEPN" Tag="2" Content="Степновское" Style="{StaticResource radioButtonStyle}"/>
                            <RadioButton GroupName="townChecked" x:Name="NOVOP" Tag="5" Content="Кировское" Style="{StaticResource radioButtonStyle}"/>
                            <RadioButton GroupName="townChecked" x:Name="MANUAL" Tag="6" Content="Ручной ввод" Style="{StaticResource radioButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="7" 
                    Background="WhiteSmoke"
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15" Grid.ColumnSpan="2" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопки -->
                            <!-- Заголовок -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выбор юрисконсульта" 
                            FontWeight="Bold" 
                            FontSize="13" 
                            Foreground="#4B5563" 
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Margin="0,0,0,12"
                            Grid.Row="0"/>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <!-- Небольшой отступ между кнопками -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <RadioButton GroupName="lawyerChecked" x:Name="LOVANNIKOV" Tag="1" Content="С. В. Ловянников" Style="{StaticResource newradioButtonStyle}"
VerticalAlignment="Stretch" Grid.Row="0"  HorizontalAlignment="Stretch" />

                            <RadioButton GroupName="lawyerChecked" x:Name="KOROL" Tag="2" Content="О. А. Король" Style="{StaticResource newradioButtonStyle}"
VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" />
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- DATAGRID (ИСПРАВЛЕНЫ ЗАГОЛОВКИ И КОЛОНКИ) -->
        <!-- ========================================== -->
        <DataGrid x:Name="dataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="True"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#CCCCCC"
                  VerticalGridLinesBrush="#CCCCCC"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F9F9F9"
                  BorderThickness="0"
                  Margin="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Background" Value="#EFEFEF"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0,1,1,0"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <!-- 1. Судебный пристав -->
                <DataGridTextColumn Binding="{Binding CourtOfficer}" Width="Auto" MinWidth="200">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Судебный пристав и иная информация"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 2. Дата проверки -->
                <DataGridTextColumn Binding="{Binding DateOfVerification, StringFormat={}{0:dd.MM.yyyy}}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата проверки"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 3. № судебного участка -->
                <DataGridTextColumn Binding="{Binding NumberOfJudicalArea}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№ судебного участка"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 4. Лицевой счёт -->
                <DataGridTextColumn Binding="{Binding Account}" Width="120">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Лицевой счёт"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!-- 5. ФИО должника -->
                <DataGridTextColumn Binding="{Binding FullName}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ФИО должника"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 6. Доля в праве -->
                <DataGridTextColumn Binding="{Binding Part}" Width="90">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Доля в праве"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 7. Населённый пункт -->
                <DataGridTextColumn Binding="{Binding Town}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Населённый пункт"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 8. Улица -->
                <DataGridTextColumn Binding="{Binding Street}" Width="140">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Улица"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 9. Дом -->
                <DataGridTextColumn Binding="{Binding Building}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дом"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 10. Корпус -->
                <DataGridTextColumn Binding="{Binding Korps}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Корпус"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 11. Квартира -->
                <DataGridTextColumn Binding="{Binding Flat}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Квартира"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 12. Комната -->
                <DataGridTextColumn Binding="{Binding Room}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Комната"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 13. Дата передачи MC -->
                <DataGridTextColumn Binding="{Binding RequestMCDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата передачи MC"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 14. № СП -->
                <DataGridTextColumn Binding="{Binding OrderNumber}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№ СП"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 15. Дата СП (ИСПРАВЛЕНО: было дублирование заголовка "№ СП") -->
                <DataGridTextColumn Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата СП"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 16. Дата передачи ФССП -->
                <DataGridTextColumn Binding="{Binding TransferDateFSSP, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата передачи ФССП"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 17. Дата возбуждения ИП -->
                <DataGridTextColumn Binding="{Binding InitiationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата возбуждения ИП"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 18. Примечание -->
                <DataGridTextColumn Binding="{Binding Appendex}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Примечание"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 19. Дата рождения -->
                <DataGridTextColumn Binding="{Binding BirthDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto" MinWidth="160">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата рождения должника"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 20. Период -->
                <DataGridTextColumn Binding="{Binding Period}" Width="Auto" MinWidth="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Период"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 21 Суммы: выравнивание по правому краю -->
                <DataGridTextColumn Binding="{Binding Debt, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Основной долг"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 22 пени: выравнивание по правому краю -->

                <DataGridTextColumn Binding="{Binding Punishment, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Сумма пени"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 23 госпошлина: выравнивание по правому краю -->

                <DataGridTextColumn Binding="{Binding Duty, StringFormat=N2}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Госпошлина"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 24 общая сумма: выравнивание по правому краю -->

                <DataGridTextColumn Binding="{Binding AmountSum, StringFormat=N2}" Width="130">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Сумма по исполнительному документу"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 25 документ примечание: выравнивание по правому краю -->
                <DataGridTextColumn Binding="{Binding DocumentReference}" Width="Auto" MinWidth="160">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Документ"  TextAlignment="Center"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Прогресс-бар -->
        <ProgressBar x:Name="progressBar1"
                     Visibility="Collapsed"
                     Height="5"
                     BorderThickness="5"
                     Grid.Row="2"
                     Grid.Column="0"
                     Grid.ColumnSpan="7"
                     Margin="0"/>
    </Grid>
</Window>
